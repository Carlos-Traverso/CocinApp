{
  "name": "cocinapp-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import jiti/register --test --test-isolation=none tests/profile.test.ts tests/pantry.test.ts tests/recipes.test.ts tests/planner.test.ts tests/shopping.test.ts tests/cooking.test.ts tests/dashboard.test.ts",
    "test:profile": "node --import jiti/register --test --test-isolation=none tests/profile.test.ts",
    "test:pantry": "node --import jiti/register --test --test-isolation=none tests/pantry.test.ts",
    "test:recipes": "node --import jiti/register --test --test-isolation=none tests/recipes.test.ts",
    "test:planner": "node --import jiti/register --test --test-isolation=none tests/planner.test.ts",
    "test:shopping": "node --import jiti/register --test --test-isolation=none tests/shopping.test.ts",
    "test:cooking": "node --import jiti/register --test --test-isolation=none tests/cooking.test.ts",
    "test:dashboard": "node --import jiti/register --test --test-isolation=none tests/dashboard.test.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
